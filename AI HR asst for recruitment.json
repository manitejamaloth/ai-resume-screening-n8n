        "text": "=Job posting details: \n{{ $json.content }}\n\nHere is the candidate profile summary:\n{{ $('Summarization Chain').item.json.output.text }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an HR expert responsible for evaluating how well a candidate aligns with the job profile and requirements provided by the company.  Analyze the candidate's qualifications, skills, work experience, education, and overall suitability against the job requirements.  Give the candidate an alignment score from 1 to 10, where:  1 = The candidate does not align with the job requirements. 5 = The candidate partially aligns with the job requirements. 10 = The candidate is an ideal match and strongly fulfills the desired profile.  In the \"consideration\" field, clearly explain the reasoning behind the score, including the candidate's strengths, relevant qualifications, and any important gaps compared to the job requirements.  Be objective and base your evaluation only on the information provided."
            }
          ]
        },
        "batching": {}
      },
